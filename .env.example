TAGENT_RUNTIME=in-process
TAGENT_PROVIDER=openai-compatible
TAGENT_API_BASE=https://one.tms.im/v1
TAGENT_MODEL=gpt-5.6-sol
TAGENT_CONTEXT_WINDOW=200000
TAGENT_MAX_TOKENS=32768
TAGENT_REASONING=true
TAGENT_PROVIDER_TIMEOUT_MS=120000
TAGENT_PROVIDER_MAX_RETRIES=1
TAGENT_RUN_TIMEOUT_MS=7200000
TAGENT_RUN_HARD_TIMEOUT_MS=86400000
TAGENT_MAX_CONTINUATIONS=128
TAGENT_MAX_RUN_TOKENS=2000000
TAGENT_MAX_CONTEXT_TURNS=20
TAGENT_DYNAMIC_BUDGET=true
OPENAI_API_KEY=
PORT=3100
TAGENT_DB=./data/tagent.db
TAGENT_WORKSPACE=./workspace

# Maximum queued/delivering steer and follow-up controls per active Run attempt
TAGENT_CONTROL_INBOX_CAPACITY=32

# Optional long-term memory platform. The default is false.
# false: no PostgreSQL/pgvector/S3 service or memory configuration is required;
#        TAgent Core runs with its original SQLite session/TaskRun history only.
# true: configure one of the profiles below before startup.
TAGENT_MEMORY_ENABLED=false

# Recommended persistent profile (requires PostgreSQL 17 + pgvector).
TAGENT_MEMORY_BACKEND=postgres
TAGENT_MEMORY_POSTGRES_URL=postgresql://tagent:tagent@127.0.0.1:5432/tagent_memory

# Development-only non-persistent metadata/vector/graph adapter:
# TAGENT_MEMORY_BACKEND=memory
# TAGENT_MEMORY_POSTGRES_URL is not required for this backend.

# Cold topic bodies: local requires only a writable directory. S3 requires the
# optional S3 settings below and AWS-compatible credentials/environment.
TAGENT_MEMORY_COLD_BACKEND=local
TAGENT_MEMORY_COLD_PATH=./data/memory-cold
TAGENT_MEMORY_WORKSPACE_SCOPE_ID=default
TAGENT_MEMORY_WORKER_INTERVAL_MS=1000
TAGENT_MEMORY_MAINTENANCE_INTERVAL_MS=60000
TAGENT_MEMORY_WARM_AFTER_MS=0
TAGENT_MEMORY_HOT_TTL_MS=2592000000
TAGENT_MEMORY_COLD_MINIMUM_RECORDS=2
TAGENT_MEMORY_RECALL_TOKEN_BUDGET=8000

# S3-compatible cold storage (required only when COLD_BACKEND=s3).
TAGENT_MEMORY_S3_BUCKET=
TAGENT_MEMORY_S3_PREFIX=tagent-memory
TAGENT_MEMORY_S3_ENDPOINT=
TAGENT_MEMORY_S3_REGION=us-east-1
TAGENT_MEMORY_S3_FORCE_PATH_STYLE=false
