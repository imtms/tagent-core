TAGENT_RUNTIME=in-process
TAGENT_PROVIDER=openai-compatible
TAGENT_API_BASE=https://one.tms.im/v1
TAGENT_MODEL=gpt-5.6-sol
TAGENT_CONTEXT_WINDOW=200000
TAGENT_MAX_TOKENS=32768
TAGENT_REASONING=true
TAGENT_PROVIDER_TIMEOUT_MS=15000
TAGENT_PROVIDER_MAX_RETRIES=1
# Fast semantic router model. It receives bounded recent Session/TaskRun context.
TAGENT_ROUTER_MODEL=gpt-5.6-luna
TAGENT_ROUTER_TIMEOUT_MS=15000
TAGENT_ROUTER_CONTEXT_WINDOW=64000
TAGENT_ROUTER_MAX_TOKENS=2048
TAGENT_ROUTER_REASONING=false
# Optional; defaults to TAGENT_PROVIDER / TAGENT_API_BASE.
TAGENT_ROUTER_PROVIDER=
TAGENT_ROUTER_API_BASE=
# Fast final quality audit model. Transport failures fall back once to TAGENT_MODEL.
TAGENT_SUPERVISOR_MODEL=gpt-5.6-luna
TAGENT_SUPERVISOR_TIMEOUT_MS=15000
TAGENT_SUPERVISOR_CONTEXT_WINDOW=64000
TAGENT_SUPERVISOR_MAX_TOKENS=1024
TAGENT_SUPERVISOR_REASONING=false
# Optional; defaults to TAGENT_PROVIDER / TAGENT_API_BASE.
TAGENT_SUPERVISOR_PROVIDER=
TAGENT_SUPERVISOR_API_BASE=
TAGENT_RUN_TIMEOUT_MS=15000
TAGENT_RUN_HARD_TIMEOUT_MS=86400000
TAGENT_MAX_CONTINUATIONS=128
TAGENT_MAX_CONTEXT_TURNS=20
OPENAI_API_KEY=
PORT=3100
TAGENT_DB=./data/tagent.db
TAGENT_WORKSPACE=./workspace

# Maximum queued/delivering steer and follow-up controls per active Run attempt
TAGENT_CONTROL_INBOX_CAPACITY=32

# Optional scoped Bearer credentials for external automation clients.
# JSON array of {"token":"at-least-24-characters","scopes":["sessions:read",...]}
TAGENT_SERVICE_CREDENTIALS=

# Optional long-term memory platform. Default false: original SQLite-only TAgent Core.
TAGENT_MEMORY_ENABLED=false
TAGENT_MEMORY_BACKEND=postgres
TAGENT_MEMORY_POSTGRES_URL=postgresql://tagent:tagent@127.0.0.1:5432/tagent_memory
TAGENT_MEMORY_COLD_BACKEND=local
TAGENT_MEMORY_COLD_PATH=./data/memory-cold
TAGENT_MEMORY_WORKSPACE_SCOPE_ID=default
TAGENT_MEMORY_WORKER_INTERVAL_MS=1000
TAGENT_MEMORY_MAINTENANCE_INTERVAL_MS=60000
TAGENT_MEMORY_WARM_AFTER_MS=0
TAGENT_MEMORY_HOT_TTL_MS=2592000000
TAGENT_MEMORY_CANDIDATE_TTL_MS=7776000000
TAGENT_MEMORY_DELETED_GRACE_PERIOD_MS=2592000000
TAGENT_MEMORY_FACT_STALE_MS=31536000000
TAGENT_MEMORY_FACT_DELETE_MS=63072000000
TAGENT_MEMORY_PREFERENCE_STALE_MS=31536000000
TAGENT_MEMORY_PREFERENCE_DELETE_MS=63072000000
TAGENT_MEMORY_EPISODE_STALE_MS=7776000000
TAGENT_MEMORY_EPISODE_DELETE_MS=15552000000
TAGENT_MEMORY_PROCEDURE_STALE_MS=15552000000
TAGENT_MEMORY_PROCEDURE_DELETE_MS=31536000000
TAGENT_MEMORY_COLD_MINIMUM_RECORDS=2
TAGENT_MEMORY_S3_BUCKET=
TAGENT_MEMORY_S3_PREFIX=tagent-memory
TAGENT_MEMORY_S3_ENDPOINT=
TAGENT_MEMORY_S3_REGION=us-east-1
TAGENT_MEMORY_S3_FORCE_PATH_STYLE=false
TAGENT_MEMORY_EMBEDDING_PROVIDER=none
TAGENT_MEMORY_EMBEDDING_BASE_URL=
TAGENT_MEMORY_EMBEDDING_API_KEY=
TAGENT_MEMORY_EMBEDDING_MODEL=
TAGENT_MEMORY_EMBEDDING_DIMENSIONS=
TAGENT_MEMORY_EMBEDDING_BATCH_SIZE=64
TAGENT_MEMORY_EXTRACTOR_PROVIDER=rule
TAGENT_MEMORY_EXTRACTOR_BASE_URL=
TAGENT_MEMORY_EXTRACTOR_API_KEY=
TAGENT_MEMORY_EXTRACTOR_MODEL=
TAGENT_MEMORY_EMBEDDING_EXTRA_BODY=
