TAGENT_RUNTIME=in-process
TAGENT_PROVIDER=openai-compatible
TAGENT_API_BASE=https://one.tms.im/v1
TAGENT_MODEL=gpt-5.6-sol
TAGENT_CONTEXT_WINDOW=200000
TAGENT_MAX_TOKENS=32768
TAGENT_REASONING=true
TAGENT_PROVIDER_TIMEOUT_MS=120000
TAGENT_PROVIDER_MAX_RETRIES=1
TAGENT_RUN_TIMEOUT_MS=7200000
TAGENT_RUN_HARD_TIMEOUT_MS=86400000
TAGENT_MAX_CONTINUATIONS=128
TAGENT_MAX_RUN_TOKENS=2000000
TAGENT_MAX_CONTEXT_TURNS=20
TAGENT_DYNAMIC_BUDGET=true
OPENAI_API_KEY=
PORT=3100
TAGENT_DB=./data/tagent.db
TAGENT_WORKSPACE=./workspace

# Maximum queued/delivering steer and follow-up controls per active Run attempt
TAGENT_CONTROL_INBOX_CAPACITY=32
