# Core API origin used by the independently deployed Web Console.
# Use only an HTTP(S) origin without credentials, path, query, or fragment.
VITE_TAGENT_CORE_ORIGIN=http://127.0.0.1:3100

# Do not place Core service credentials or OIDC refresh tokens in this file.
# A hosting shell may place a short-lived Gateway access token in session
# storage under "tagent.oidc.access_token". Core does not validate that token;
# the Gateway must translate it to a minimal opaque Core credential.
