{
  "name": "@tagent/memory",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain.d.ts",
      "import": "./dist/domain.js"
    },
    "./ports": {
      "types": "./dist/ports.d.ts",
      "import": "./dist/ports.js"
    },
    "./composition": {
      "types": "./dist/composition.d.ts",
      "import": "./dist/composition.js"
    }
  },
  "scripts": {
    "build": "tsc -b && mkdir -p dist/postgres && cp src/postgres/schema.sql dist/postgres/schema.sql",
    "clean": "tsc -b --clean && rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1100.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  },
  "engines": {
    "node": ">=24.18.1",
    "npm": ">=12"
  },
  "license": "MIT"
}
