{
  "name": "@tagent/abi",
  "version": "0.8.27",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./admin/v1": {
      "types": "./dist/admin/v1/index.d.ts",
      "import": "./dist/admin/v1/index.js"
    },
    "./admin/profiles-v1": {
      "types": "./dist/admin/profiles-v1/index.d.ts",
      "import": "./dist/admin/profiles-v1/index.js"
    },
    "./channel/v1": {
      "types": "./dist/channel/v1/index.d.ts",
      "import": "./dist/channel/v1/index.js"
    },
    "./channel/v1/fixtures": {
      "types": "./dist/channel/v1/fixtures.d.ts",
      "import": "./dist/channel/v1/fixtures.js"
    },
    "./console/v1": {
      "types": "./dist/console/v1/index.d.ts",
      "import": "./dist/console/v1/index.js"
    },
    "./internal/v1": {
      "types": "./dist/internal/v1/index.d.ts",
      "import": "./dist/internal/v1/index.js"
    },
    "./operator/read-v1": {
      "types": "./dist/operator/read-v1/index.d.ts",
      "import": "./dist/operator/read-v1/index.js"
    },
    "./operator/session-settings-v1": {
      "types": "./dist/operator/session-settings-v1/index.d.ts",
      "import": "./dist/operator/session-settings-v1/index.js"
    },
    "./operator/inbox-v1": {
      "types": "./dist/operator/inbox-v1/index.d.ts",
      "import": "./dist/operator/inbox-v1/index.js"
    },
    "./operator/context-manifest-v1": {
      "types": "./dist/operator/context-manifest-v1/index.d.ts",
      "import": "./dist/operator/context-manifest-v1/index.js"
    },
    "./operator/skills-v1": {
      "types": "./dist/operator/skills-v1/index.d.ts",
      "import": "./dist/operator/skills-v1/index.js"
    },
    "./profiles/v1": {
      "types": "./dist/profiles/v1/index.d.ts",
      "import": "./dist/profiles/v1/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf dist"
  },
  "dependencies": {
    "typebox": "^1.1.24"
  },
  "engines": {
    "node": ">=24.18.1",
    "npm": ">=12"
  },
  "license": "MIT"
}
