{
  "name": "@tagent/workspace-local",
  "version": "0.8.13",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./local-subprocess": {
      "types": "./dist/local-subprocess.d.ts",
      "import": "./dist/local-subprocess.js"
    },
    "./workspace-path": {
      "types": "./dist/workspace-path.d.ts",
      "import": "./dist/workspace-path.js"
    },
    "./artifact-file-sink": {
      "types": "./dist/artifact-file-sink.d.ts",
      "import": "./dist/artifact-file-sink.js"
    },
    "./project-context": {
      "types": "./dist/project-context.d.ts",
      "import": "./dist/project-context.js"
    },
    "./snapshot-edit": {
      "types": "./dist/snapshot-edit.d.ts",
      "import": "./dist/snapshot-edit.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/build-files.mjs copy-executable src/workspace-fd-helper.py dist/workspace-fd-helper.py",
    "clean": "tsc -b --clean && rm -rf dist"
  },
  "dependencies": {
    "@tagent/execution": "0.8.13",
    "typebox": "^1.1.24"
  },
  "engines": {
    "node": ">=24.18.1",
    "npm": ">=12"
  },
  "license": "MIT"
}
