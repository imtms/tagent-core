{
  "name": "@tagent/persistence-sqlite",
  "version": "0.8.14",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./writer": {
      "types": "./dist/writer.d.ts",
      "import": "./dist/writer.js"
    },
    "./unit-of-work": {
      "types": "./dist/unit-of-work.d.ts",
      "import": "./dist/unit-of-work.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/build-files.mjs copy src/schema dist/schema",
    "clean": "tsc -b --clean && rm -rf dist"
  },
  "dependencies": {
    "@tagent/admission": "0.8.14",
    "@tagent/execution": "0.8.14",
    "@tagent/governance": "0.8.14",
    "@tagent/memory": "0.8.14",
    "better-sqlite3": "12.4.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13"
  },
  "engines": {
    "node": ">=24.18.1",
    "npm": ">=12"
  },
  "license": "MIT"
}
