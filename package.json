{
  "name": "tagent-core",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "A minimal persistent TAgent built around pi agent core.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:web": "vite --config ./vite.config.ts --host 0.0.0.0",
    "build": "tsc -p tsconfig.server.json && vite build --config ./vite.config.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@fastify/cors": "^11.3.0",
    "better-sqlite3": "12.4.1",
    "fastify": "^5.10.0",
    "lucide-react": "0.553.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typebox": "^1.1.24"
  },
  "overrides": {
    "minimatch": "10.2.6",
    "brace-expansion": "5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "^9.2.4",
    "eslint": "^10.8.0",
    "playwright": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
