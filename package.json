{
  "name": "tagent-core",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal persistent TAgent built around pi agent core.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:web": "vite --config ./vite.config.ts --host 0.0.0.0",
    "build": "tsc -p tsconfig.server.json && vite build --config ./vite.config.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "better-sqlite3": "12.4.1",
    "fastify": "^5.10.0",
    "lucide-react": "0.553.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typebox": "^1.1.24"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "9.2.1",
    "eslint": "9.39.1",
    "playwright": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "3.2.4"
  }
}
